{
  "manifest_version": 3,
  "name": "ApplyPilot - AI Job Application Autofill",
  "version": "0.2.0",
  "description": "Extracts every question on a job application (ATS, company career pages, Google Forms) and fills it from your profile, resume and an LLM. Never auto-submits.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ApplyPilot"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the current application form"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/lib/rules.js",
        "src/content/util.js",
        "src/content/extractor.js",
        "src/content/sections.js",
        "src/content/gforms.js",
        "src/content/filler.js",
        "src/content/overlay.js",
        "src/content/main.js"
      ],
      "css": ["src/content/overlay.css"]
    }
  ]
}
